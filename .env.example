# ==========================================
# Alya Music Bot - Environment Configuration
# ==========================================

# -----------------
# Required Bot Settings
# -----------------
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_application_id_here
DISCORD_CLIENT_SECRET=your_client_secret_here
OWNER_IDS=your_discord_user_id_here
BOT_PREFIX=>
BOT_COLOR="#00D4FF"

# -----------------
# Database (MongoDB)
# -----------------
# Use a MongoDB Atlas URI for Pterodactyl / cloud hosting, or local URI for development
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/alya?retryWrites=true&w=majority

# -----------------
# Lavalink Audio Node (v4)
# -----------------
LAVALINK_NAME="Public Vinster Node"
LAVALINK_URL="freelavalinkvinster.in:443"
LAVALINK_PASSWORD="youshallnotpass"
LAVALINK_SECURE=true
LAVALINK_SOURCE=ytmsearch

# -----------------
# Spotify API (Optional for Spotify link resolution)
# -----------------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# -----------------
# Web Dashboard & Bridge Settings (Optional)
# -----------------
PORT=2000
BRIDGE_PORT=2000
NEXTAUTH_SECRET=your_random_32_character_secret_here
DASHBOARD_BRIDGE_SECRET=
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DASHBOARD_API_URL=http://localhost:2000
DASHBOARD_SOCKET_URL=http://localhost:2000
DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000

# -----------------
# Branding & Links
# -----------------
SUPPORT_SERVER_URL=
SUPPORT_GUILD_ID=
POWERED_BY_TEXT="Powered by Alya"
